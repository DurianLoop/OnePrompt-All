\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The reference failure landscape. Instability (best-worst Dice gap) vs.\ catastrophic failure rate across four segmenters on MoNuSAC. Each point is a query (aggregated over seeds and prompt configurations). The empirical association between instability and catastrophic failure is significant in SAM-B pipelines (DINOv2-L+SAM-B: $r=-0.51$, $p<0.001$; DINOv2-B+SAM-B: $r=-0.55$, $p<0.001$) but not in SAM2 pipelines (SAM2-Tiny: $r=-0.11$, $p=0.33$; SAM2-Small: $r=-0.18$, $p=0.11$). All correlations are query-level with Holm correction.}}{15}{figure.1}\protected@file@percent }
\newlabel{fig:anticorrelation}{{1}{15}{The reference failure landscape. Instability (best-worst Dice gap) vs.\ catastrophic failure rate across four segmenters on MoNuSAC. Each point is a query (aggregated over seeds and prompt configurations). The empirical association between instability and catastrophic failure is significant in SAM-B pipelines (DINOv2-L+SAM-B: $r=-0.51$, $p<0.001$; DINOv2-B+SAM-B: $r=-0.55$, $p<0.001$) but not in SAM2 pipelines (SAM2-Tiny: $r=-0.11$, $p=0.33$; SAM2-Small: $r=-0.18$, $p=0.11$). All correlations are query-level with Holm correction}{figure.1}{}}
